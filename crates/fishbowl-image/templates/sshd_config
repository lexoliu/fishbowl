# Generated by fishbowl.
Port {{ ssh_port }}
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile {{ authorized_keys }}
AllowUsers {{ researcher_user }}
X11Forwarding no
AllowAgentForwarding no
# An agent's borrowed credential is fetched from the host over a remote-forwarded unix
# socket, so remote forwarding is the one forwarding direction that stays on. Both
# keywords are needed for it: sshd gates a remote stream-local forward on the *TCP*
# remote permission as well, because `AllowTcpForwarding` is what
# `channel_disable_admin(ssh, FORWARD_REMOTE)` is derived from in session.c, and the
# socket request is then refused by the same admin check that refuses a TCP one. With
# `AllowTcpForwarding no` the socket is denied however this next line is set.
#
# Widening it to `remote` costs nothing here. Every forward is opened by the client, and
# the client is the host that holds the keys; the sandbox cannot ask for one. A remote
# forward only lets the host publish one of its own endpoints inside the sandbox, which
# is exactly what the agent socket is. Local forwarding stays off, so the host cannot
# use the sandbox to originate connections either.
AllowTcpForwarding remote
AllowStreamLocalForwarding remote
# A socket left behind by an attachment that was killed rather than closed would
# otherwise make the next attachment to the same machine fail to bind, and the host names
# each socket for one attachment, so the only file this can ever unlink is a dead one.
StreamLocalBindUnlink yes
PermitTunnel no
PrintMotd no
# The locale, and the researcher's own MalwareBazaar key by name. An agent's borrowed
# credential is not accepted here: it reaches the sandbox over the forwarded socket and
# is put into the environment of the one process that needs it, by the courier. The
# researcher's key is different in kind — it is theirs, it is wanted by every tool the
# researcher account runs, and the account it lands in is not the one samples run as —
# so it is accepted, and only it: an allow-list by name means nothing else the host
# happens to have set can follow it in.
AcceptEnv LANG LC_* {{ malwarebazaar_key }}
