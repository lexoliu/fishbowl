# Generated by cyber-sandbox. Edits are overwritten each time the context is staged.
# The two programs that live inside the sandbox: the gateway that audits its egress, and
# the courier that holds an agent's borrowed credential for exactly as long as the agent
# runs. Both are built from the same source tree the host CLI is, so the file format the
# courier writes and the host writes can only ever be one format.
FROM rust:1-bookworm AS guest
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --locked {{ guest_crates }} \
 && strip target/release/cyber-sandbox-gateway target/release/cyber-sandbox-courier

{%- if let Some(openssh) = openssh %}

# Rosetta cannot install a seccomp filter — `prctl(PR_SET_SECCOMP)` returns EINVAL in a
# translated guest — and Kali's sshd is compiled with the seccomp_filter privilege
# separation sandbox. Its preauth child dies on that call and every connection is reset
# before key exchange finishes. The mechanism is a configure-time choice with no
# sshd_config keyword, so the only sshd that can serve a translated guest is one built
# against a different one. The same base image is used, so the result links against the
# glibc and PAM the final stage actually has.
FROM {{ base_image }} AS sshd
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl libcrypt-dev libpam0g-dev libssl-dev zlib1g-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# The checksum is pinned, so a mirror serving a different tarball fails the build here
# rather than putting an unreviewed sshd in front of the sandbox.
RUN curl -fsSLo openssh.tar.gz \
      https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-{{ openssh.version() }}.tar.gz \
 && printf '%s  openssh.tar.gz\n' '{{ openssh.sha256() }}' | sha256sum --check --strict \
 && tar -xzf openssh.tar.gz --strip-components=1 \
 && rm openssh.tar.gz

# Rosetta supports neither of the two mechanisms Linux offers: `rlimit` confines the
# preauth child by zeroing RLIMIT_FSIZE and RLIMIT_NOFILE, and configure refuses to
# enable it because `select` no longer works afterwards under translation. What is given
# up is a layer around the preauth child, not privilege separation — it still runs as an
# unprivileged chrooted account — and it is the layer this design leans on least, since
# the boundary here is the virtual machine.
# `install-nosysconf` installs the binaries and nothing under /etc/ssh, which is what
# keeps Kali's own sshd_config — and the `Include sshd_config.d/*.conf` line the drop-in
# depends on — intact in the final image. The libexec path matches Debian's layout,
# because sshd resolves its helpers by a path compiled into it.
RUN ./configure --prefix=/usr --sysconfdir=/etc/ssh --libexecdir=/usr/lib/openssh \
      --with-privsep-path=/run/sshd --with-pam --with-sandbox={{ openssh.sandbox() }} \
 && make -j"$(nproc)" \
 && make install-nosysconf DESTDIR=/out \
 && /out/usr/sbin/sshd -V 2>&1 | grep -q 'OpenSSH_{{ openssh.version() }}'
{%- endif %}

FROM {{ base_image }}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
LABEL org.opencontainers.image.source=https://github.com/lexoliu/cyber-sandbox

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
{%- for package in packages %}
      {{ package }} \
{%- endfor %}
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Three accounts, because the machine has three kinds of process in it and each pair of
# them needs telling apart. The gateway is the only one allowed to reach the network
# directly, which is how the packet filter tells audited traffic from traffic to be
# audited. The researcher account is the researcher's own shell and both agents, and is
# the account an agent's borrowed token is written for. Samples run as neither: they are
# detonated under an account that owns nothing, so reading that token is not among the
# things a sample can do by simply opening a file.
#
# The researcher's home is closed to the other two. Under it are the agent's settings and
# every conversation it has had here, which is not material to leave a sample able to read.
#
# The working directory is shared, because a sample is detonated on the files the
# researcher put there and the researcher wants what it leaves behind. It is setgid so
# that whichever account wrote a file, the other can still reach it.
RUN groupadd --gid {{ gateway_gid }} {{ gateway_user }} \
 && useradd --uid {{ gateway_uid }} --gid {{ gateway_gid }} --home-dir {{ gateway_home }} \
      --create-home --shell /usr/sbin/nologin {{ gateway_user }} \
 && groupadd --gid {{ researcher_gid }} {{ researcher_user }} \
 && useradd --uid {{ researcher_uid }} --gid {{ researcher_gid }} --home-dir /home/{{ researcher_user }} \
      --create-home --shell /bin/bash {{ researcher_user }} \
 && groupadd --gid {{ detonate_gid }} {{ detonate_user }} \
 && useradd --uid {{ detonate_uid }} --gid {{ detonate_gid }} --home-dir /home/{{ detonate_user }} \
      --create-home --shell /bin/bash {{ detonate_user }} \
 && usermod --append --groups {{ detonate_user }} {{ researcher_user }} \
 && mkdir -p {{ audit_directory }} /run/sshd {{ samples_dir }} {{ work_dir }} \
 && chown {{ gateway_uid }}:{{ gateway_gid }} {{ audit_directory }} \
 && chown {{ researcher_uid }}:{{ detonate_gid }} {{ work_dir }} \
 && chmod 0750 {{ audit_directory }} \
 && chmod 0700 /home/{{ researcher_user }} \
 && chmod 2770 {{ work_dir }}

# Codex runs only its exec-server here, with the model side and the credential left on
# the host. Claude Code runs here in full, on a token the courier lends it for as long as
# it runs; what stays on the host in that case is the login that renews the token. Devin
# runs here in full on the same arrangement, lent its credentials file rather than a
# token.
RUN npm install --global --no-fund --no-audit {{ agent_packages }}

# Devin has no published package, so the third agent is installed by its own installer:
# it fetches the bundle its manifest names and checks it against the manifest's checksum
# before linking it into ~/.local/bin. That is inside the researcher's home on purpose —
# the CLI's self-updater writes beside it — and the install runs as the researcher for
# the same reason, with HOME pinned because a build-time USER does not set it. The
# installer's own exit is discarded because it ends by running `devin setup`, an
# interactive login wizard that cannot succeed on a builder with no terminal; what the
# build is actually after is the binary, so the test on it — not the wizard — is what
# fails the build rather than the session if the binary does not land where the courier
# goes looking for it.
USER {{ researcher_user }}
RUN curl --fail --silent --show-error --location https://cli.devin.ai/install.sh \
      | env HOME=/home/{{ researcher_user }} bash; \
    test -x /home/{{ researcher_user }}/.local/bin/devin
USER root

# The first-run questions, answered. Claude Code otherwise opens a session by asking
# about a colour scheme, about trusting a directory this image created, and about running
# without approvals — and Devin by asking to finish its shell setup and to trust the
# same directory. They are questions about a machine the researcher asked for by name,
# in front of an agent that was started to work unattended.
COPY claude.json /home/{{ researcher_user }}/.claude.json
COPY claude-settings.json /home/{{ researcher_user }}/.claude/settings.json
COPY statusline.sh {{ status_line_program }}
COPY devin-config.json /home/{{ researcher_user }}/.config/devin/config.json
COPY devin-trusted-workspaces.json \
     /home/{{ researcher_user }}/.local/share/devin/cli/trusted_workspaces.json
RUN chown -R {{ researcher_uid }}:{{ researcher_gid }} /home/{{ researcher_user }}/.claude.json \
      /home/{{ researcher_user }}/.claude \
      /home/{{ researcher_user }}/.config \
 && chown {{ researcher_uid }}:{{ researcher_gid }} \
      /home/{{ researcher_user }}/.local/share/devin/cli/trusted_workspaces.json \
 && chmod 0600 /home/{{ researcher_user }}/.claude.json \
      /home/{{ researcher_user }}/.claude/settings.json \
 && chmod 0755 {{ status_line_program }}

# Becoming the detonation account is the one thing the researcher account may do that it
# could not do on its own, and it is granted by a single sudoers rule that does not name
# root. `visudo` checks the file here, so a rule that would not parse fails the build
# rather than leaving a session where nothing can be detonated at all.
COPY sudoers /etc/sudoers.d/cyber-sandbox
COPY detonate.sh /usr/local/bin/detonate
RUN chown root:root /etc/sudoers.d/cyber-sandbox \
 && chmod 0440 /etc/sudoers.d/cyber-sandbox \
 && chmod 0755 /usr/local/bin/detonate \
 && visudo -cs -f /etc/sudoers.d/cyber-sandbox

# The gateway needs CAP_NET_ADMIN to bind the netfilter log group, and it needs it after
# the entrypoint has dropped to the gateway account. A file capability grants exactly
# that at exec, with no securebits juggling; the mode keeps the researcher account from
# executing the one binary in the image that carries a capability. `getcap` failing here
# fails the build, because a filesystem that silently discarded the xattr would leave the
# gateway unable to report refused packets.
COPY --from=guest /src/target/release/cyber-sandbox-gateway /usr/local/bin/cyber-sandbox-gateway
RUN chown root:{{ gateway_user }} /usr/local/bin/cyber-sandbox-gateway \
 && chmod 0050 /usr/local/bin/cyber-sandbox-gateway \
 && setcap cap_net_admin+ep /usr/local/bin/cyber-sandbox-gateway \
 && getcap /usr/local/bin/cyber-sandbox-gateway | grep -q cap_net_admin

{%- if let Some(openssh) = openssh %}

# Take the packaged sshd out of the way of the rlimit-sandboxed build. All three binaries
# of the privilege separation chain come from the same source tree — sshd execs
# sshd-session, which execs sshd-auth, and a version mismatch between them is fatal at
# connection time. The configuration files are deliberately left to Kali's package.
COPY --from=sshd /out/usr/sbin/sshd /usr/sbin/sshd
COPY --from=sshd /out/usr/lib/openssh/sshd-session /usr/lib/openssh/sshd-session
COPY --from=sshd /out/usr/lib/openssh/sshd-auth /usr/lib/openssh/sshd-auth
RUN /usr/sbin/sshd -V 2>&1 | grep -q 'OpenSSH_{{ openssh.version() }}'
{%- endif %}

# The courier is what the host starts over ssh in place of the agent itself. It runs as
# the researcher account like anything else here, and holds no privilege of its own: the
# credential it writes arrives over a socket the host opened, and is gone from the disk
# again when the agent it was borrowed for exits.
COPY --from=guest /src/target/release/cyber-sandbox-courier /usr/local/bin/cyber-sandbox-courier
RUN chmod 0755 /usr/local/bin/cyber-sandbox-courier

COPY entrypoint.sh /usr/local/bin/cyber-sandbox-entrypoint
COPY egress-policy.sh /usr/local/lib/cyber-sandbox/egress-policy.sh
COPY sshd_config /etc/ssh/sshd_config.d/cyber-sandbox.conf
RUN chmod 0755 /usr/local/bin/cyber-sandbox-entrypoint /usr/local/lib/cyber-sandbox/egress-policy.sh

# Intercepted TLS only verifies inside the sandbox if the toolchains the researcher and
# the agents actually use read the system store. Node, Python's requests and everything
# built on OpenSSL each look somewhere different, so each is pointed at the bundle
# `update-ca-certificates` regenerates once the gateway's authority is installed.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR {{ work_dir }}
ENTRYPOINT ["/usr/local/bin/cyber-sandbox-entrypoint"]
